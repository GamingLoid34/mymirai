rules_version = '2';

// Deploy (la-familia / delat projekt): från projektroten —
//   firebase deploy --only storage --project=la-familia-5d9f5
// Utan deploy av denna fil får du oftast "unauthorized" vid uppladdning till
// documents/{uid}/… eftersom äldre regler saknar denna path.
// Matchar familyId-tänk för homework-underlag under families/…

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userFamilyId() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
        .data.get('familyId', '');
    }

    match /families/{familyId}/homework/{homeworkId}/{fileName} {
      allow read: if signedIn() && userFamilyId() == familyId;
      allow write: if signedIn() && userFamilyId() == familyId
        && request.resource.size < 30 * 1024 * 1024;
    }

    // Vuxen-dokument (My Mirai) — ägarspecifikt underlag för extractTextFromDocument.
    match /documents/{ownerUid}/{documentId}/{file=**} {
      allow read: if signedIn() && request.auth.uid == ownerUid;
      allow create, update: if signedIn()
        && request.auth.uid == ownerUid
        && request.resource.size < 25 * 1024 * 1024;
      allow delete: if signedIn() && request.auth.uid == ownerUid;
    }

    // Saga-ljud från listeningStory (upload sker via Admin SDK).
    match /families/{familyId}/listeningStories/{fileName} {
      allow read: if signedIn() && userFamilyId() == familyId;
      allow write: if false;
    }
  }
}
